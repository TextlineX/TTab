{
  "manifest_version": 4,
  "name": "TTab - 灵动书签",
  "version": "0.1.4",
  "description": "极简、高效、充满动感的现代化浏览器书签管理工具。",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "tabs",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://images.unsplash.com https://www.google.com chrome-extension://*;"
  }
}
